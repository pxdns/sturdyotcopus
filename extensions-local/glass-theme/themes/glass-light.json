  "tokenColors": [
    {
      "name": "Default",
      "scope": [
        "source",
        "text"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#008000"
      }
    },
    {
      "name": "XML doc comments (C#)",
      "scope": [
        "comment.block.documentation.cs",
        "comment.line.documentation.cs",
        "comment.documentation",
        "comment.block.documentation",
        "punctuation.definition.comment.documentation.cs",
        "entity.name.tag.localname.cs",
        "entity.other.attribute-name.localname.cs",
        "punctuation.separator.hyphen.cs"
      ],
      "settings": {
        "foreground": "#008000"
      }
    },
    {
      "name": "C# line/block comments",
      "scope": [
        "comment.line.double-slash.cs",
        "comment.block.cs",
        "comment.line.cs"
      ],
      "settings": {
        "foreground": "#008000"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.quoted.double.cs",
        "string.quoted.single.cs",
        "string.quoted.double.verbatim.cs",
        "string.quoted.interpolated.cs",
        "string.quoted.double.raw.cs",
        "string.template",
        "string.quoted.double.json",
        "string.quoted.single.js",
        "string.quoted.double.js",
        "string.quoted.single.ts",
        "string.quoted.double.ts"
      ],
      "settings": {
        "foreground": "#A31515"
      }
    },
    {
      "name": "String escapes",
      "scope": [
        "constant.character.escape",
        "constant.character.escape.cs",
        "constant.character.string.escape"
      ],
      "settings": {
        "foreground": "#C50000"
      }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp",
        "constant.other.character-class.regexp"
      ],
      "settings": {
        "foreground": "#811F3F"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "constant.numeric.cs",
        "constant.numeric.decimal.cs",
        "constant.numeric.hex.cs",
        "constant.numeric.binary.cs",
        "constant.numeric.json",
        "keyword.other.unit",
        "keyword.other.unit.css"
      ],
      "settings": {
        "foreground": "#098658"
      }
    },
    {
      "name": "Constants / enum members",
      "scope": [
        "constant.language",
        "constant.language.cs",
        "constant.language.boolean",
        "constant.language.null",
        "support.constant",
        "variable.other.enummember",
        "variable.other.enummember.cs",
        "variable.other.constant",
        "constant.other",
        "entity.name.variable.enum-member"
      ],
      "settings": {
        "foreground": "#0070C1"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.other",
        "keyword.other.cs",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.cast",
        "keyword.operator.new.cs",
        "keyword.other.using.cs",
        "keyword.other.namespace.cs",
        "keyword.other.get.cs",
        "keyword.other.set.cs",
        "keyword.other.var.cs",
        "keyword.other.await.cs",
        "keyword.other.import",
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#0000FF"
      }
    },
    {
      "name": "Storage / modifiers",
      "scope": [
        "storage",
        "storage.type",
        "storage.type.cs",
        "storage.type.var.cs",
        "storage.type.function",
        "storage.type.class",
        "storage.modifier",
        "storage.modifier.cs",
        "storage.modifier.import"
      ],
      "settings": {
        "foreground": "#0000FF"
      }
    },
    {
      "name": "Primitive types (C#)",
      "scope": [
        "keyword.type.cs",
        "storage.type.cs"
      ],
      "settings": {
        "foreground": "#0000FF"
      }
    },
    {
      "name": "Control flow keywords",
      "scope": [
        "keyword.control",
        "keyword.control.cs",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.trycatch",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.default",
        "keyword.control.switch",
        "keyword.control.exception",
