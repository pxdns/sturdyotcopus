  "tokenColors": [
    {
      "name": "Default",
      "scope": [
        "source",
        "text"
      ],
      "settings": {
        "foreground": "#d4d4d4"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6a9955"
      }
    },
    {
      "name": "XML doc comments (C#)",
      "scope": [
        "comment.block.documentation.cs",
        "comment.line.documentation.cs",
        "comment.documentation",
        "comment.block.documentation",
        "punctuation.definition.comment.documentation.cs",
        "entity.name.tag.localname.cs",
        "entity.other.attribute-name.localname.cs",
        "punctuation.separator.hyphen.cs"
      ],
      "settings": {
        "foreground": "#6e9e5a"
      }
    },
    {
      "name": "C# line/block comments",
      "scope": [
        "comment.line.double-slash.cs",
        "comment.block.cs",
        "comment.line.cs"
      ],
      "settings": {
        "foreground": "#6a9955"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.quoted.double.cs",
        "string.quoted.single.cs",
        "string.quoted.double.verbatim.cs",
        "string.quoted.interpolated.cs",
        "string.quoted.double.raw.cs",
        "string.template",
        "string.quoted.double.json",
        "string.quoted.single.js",
        "string.quoted.double.js",
        "string.quoted.single.ts",
        "string.quoted.double.ts"
      ],
      "settings": {
        "foreground": "#ce9178"
      }
    },
    {
      "name": "String escapes",
      "scope": [
        "constant.character.escape",
        "constant.character.escape.cs",
        "constant.character.string.escape"
      ],
      "settings": {
        "foreground": "#d7ba7d"
      }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp",
        "constant.other.character-class.regexp"
      ],
      "settings": {
        "foreground": "#e07b7b"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "constant.numeric.cs",
        "constant.numeric.decimal.cs",
        "constant.numeric.hex.cs",
        "constant.numeric.binary.cs",
        "constant.numeric.json",
        "keyword.other.unit",
        "keyword.other.unit.css"
      ],
      "settings": {
        "foreground": "#b5cea8"
      }
    },
    {
      "name": "Constants / enum members",
      "scope": [
        "constant.language",
        "constant.language.cs",
        "constant.language.boolean",
        "constant.language.null",
        "support.constant",
        "variable.other.enummember",
        "variable.other.enummember.cs",
        "variable.other.constant",
        "constant.other",
        "entity.name.variable.enum-member"
      ],
      "settings": {
        "foreground": "#4fc1ff"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.other",
        "keyword.other.cs",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.cast",
        "keyword.operator.new.cs",
        "keyword.other.using.cs",
        "keyword.other.namespace.cs",
        "keyword.other.get.cs",
        "keyword.other.set.cs",
        "keyword.other.var.cs",
        "keyword.other.await.cs",
        "keyword.other.import",
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#569cd6"
      }
    },
    {
      "name": "Storage / modifiers",
      "scope": [
        "storage",
        "storage.type",
        "storage.type.cs",
        "storage.type.var.cs",
        "storage.type.function",
        "storage.type.class",
        "storage.modifier",
        "storage.modifier.cs",
        "storage.modifier.import"
      ],
      "settings": {
        "foreground": "#569cd6"
      }
    },
    {
      "name": "Primitive types (C#)",
      "scope": [
        "keyword.type.cs",
        "storage.type.cs"
      ],
      "settings": {
        "foreground": "#569cd6"
      }
    },
    {
      "name": "Control flow keywords",
      "scope": [
        "keyword.control",
        "keyword.control.cs",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.trycatch",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.default",
        "keyword.control.switch",
        "keyword.control.exception",
        "keyword.control.flow.cs",
        "keyword.control.try.cs",
        "keyword.control.catch.cs",
        "keyword.control.finally.cs"
      ],
      "settings": {
        "foreground": "#c586c0"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.arithmetic",
        "keyword.operator.assignment",
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "keyword.operator.relational",
        "keyword.operator.cs",
        "keyword.operator.assignment.cs",
        "keyword.operator.arithmetic.cs",
        "keyword.operator.comparison.cs",
        "keyword.operator.logical.cs",
        "keyword.operator.null-coalescing.cs",
        "keyword.operator.conditional.question-mark.cs",
        "keyword.operator.lambda.cs",
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "punctuation.curlybrace.open.cs",
        "punctuation.curlybrace.close.cs",
        "punctuation.parenthesis.open.cs",
        "punctuation.parenthesis.close.cs",
        "punctuation.squarebracket.open.cs",
        "punctuation.squarebracket.close.cs",
        "punctuation.comma.cs",
        "punctuation.semicolon.cs",
        "punctuation.accessor.cs",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#d4d4d4"
      }
    },
    {
      "name": "Types / classes / interfaces / structs / enums",
      "scope": [
        "entity.name.type",
        "entity.name.type.class",
        "entity.name.type.class.cs",
        "entity.name.type.interface",
        "entity.name.type.interface.cs",
        "entity.name.type.struct",
        "entity.name.type.struct.cs",
        "entity.name.type.enum",
        "entity.name.type.enum.cs",
        "entity.name.type.delegate",
        "entity.name.type.delegate.cs",
        "entity.name.type.record.cs",
        "entity.name.type.alias",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "support.type",
        "support.type.cs",
        "storage.type.cs.class",
        "meta.return-type",
        "entity.name.type.type-parameter",
        "entity.name.type.type-parameter.cs"
      ],
      "settings": {
        "foreground": "#4ec9b0"
      }
    },
    {
      "name": "Namespaces",
      "scope": [
        "entity.name.namespace",
        "entity.name.type.namespace",
        "entity.name.type.namespace.cs",
        "entity.name.module",
        "entity.name.type.module",
        "support.module"
      ],
      "settings": {
        "foreground": "#4ec9b0"
      }
    },
    {
      "name": "Methods / functions",
      "scope": [
        "entity.name.function",
        "entity.name.function.cs",
        "entity.name.function.member",
        "entity.name.function.extension.cs",
        "entity.name.function.local.cs",
        "support.function",
        "meta.function-call",
        "meta.method-call",
        "meta.function-call entity.name.function",
        "variable.function",
        "support.constant.handlebars"
      ],
      "settings": {
        "foreground": "#dcdcaa"
      }
    },
    {
      "name": "Variables / parameters / properties / fields",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.other.readwrite.cs",
        "variable.other.object",
        "variable.other.object.property",
        "variable.other.property",
        "variable.other.property.cs",
        "variable.other.field",
        "variable.other.field.cs",
        "variable.other.local.cs",
        "variable.other.constant.cs",
        "variable.parameter",
        "variable.parameter.cs",
        "variable.language",
        "variable.name",
        "meta.object-literal.key",
        "meta.definition.variable",
        "meta.definition.property",
        "support.variable",
        "entity.name.variable",
        "entity.name.variable.local.cs",
        "entity.name.variable.parameter.cs",
        "entity.name.variable.property.cs",
        "entity.name.variable.field.cs",
        "string.unquoted.alias.cs",
        "string.other.cs"
      ],
      "settings": {
        "foreground": "#9cdcfe"
      }
    },
    {
      "name": "this / base",
      "scope": [
        "variable.language.this",
        "variable.language.this.cs",
        "variable.language.base.cs",
        "variable.language.super",
        "keyword.other.this.cs",
        "keyword.other.base.cs"
