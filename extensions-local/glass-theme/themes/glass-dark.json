  "tokenColors": [
    {
      "name": "Default",
      "scope": [
        "source",
        "text"
      ],
      "settings": {
        "foreground": "#D4D4D4"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6A9955"
      }
    },
    {
      "name": "XML doc comments (C#)",
      "scope": [
        "comment.block.documentation.cs",
        "comment.line.documentation.cs",
        "comment.documentation",
        "comment.block.documentation",
        "punctuation.definition.comment.documentation.cs",
        "entity.name.tag.localname.cs",
        "entity.other.attribute-name.localname.cs",
        "punctuation.separator.hyphen.cs"
      ],
      "settings": {
        "foreground": "#6E9E5A"
      }
    },
    {
      "name": "C# line/block comments",
      "scope": [
        "comment.line.double-slash.cs",
        "comment.block.cs",
        "comment.line.cs"
      ],
      "settings": {
        "foreground": "#6A9955"
      }
    },
    {
      "name": "Strings",
      "scope": [
