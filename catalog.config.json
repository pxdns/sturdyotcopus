{
  "_comment": "Controls scripts/build-catalog.mjs: mirrors web-compatible Open VSX extensions into public/gallery/ at build time. 'quotas' reserve room per category so a few big extensions cannot crowd out many useful small ones.",
  "openVsxUrl": "https://open-vsx.org",
  "maxExtensions": 400,
  "maxScan": 3000,
  "maxExtensionMB": 6,
  "maxTotalMB": 120,
  "maxFiles": 6000,
  "concurrency": 10,
  "minDownloads": 0,
  "allowedLicenses": [
    "MIT",
    "Apache-2.0",
    "BSD-2-Clause",
    "BSD-3-Clause",
    "ISC",
    "MPL-2.0",
    "0BSD",
    "Unlicense",
    "CC0-1.0",
    "EPL-2.0",
    "EPL-1.0",
    "LGPL-2.1",
    "LGPL-3.0",
    "GPL-2.0",
    "GPL-3.0",
    "AGPL-3.0",
    "Zlib",
    "BSL-1.0",
    "CC-BY-4.0"
  ],
  "include": ["k--kato.intellij-idea-keybindings"],
  "exclude": [],
  "maxScanSeconds": 150,
  "maxVsixMB": 2,
  "cacheDir": "node_modules/.cache/luma-catalog",
  "quotas": {
    "Themes": 170,
    "Programming Languages": 90,
    "Snippets": 60,
    "Keymaps": 25,
    "Formatters": 20,
    "Linters": 20,
    "Other": 80
  }
}
